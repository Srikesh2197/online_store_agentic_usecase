# Copy this file to .env and fill in the values. .env is ignored by git.

# Stage 0 onward
OPENAI_API_KEY=

# Stage 1 onward
ANTHROPIC_API_KEY=

# Tracing (optional for the first runs; without these, runs are logged locally only)
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
# EU: https://cloud.langfuse.com   US: https://us.cloud.langfuse.com
LANGFUSE_BASE_URL=https://cloud.langfuse.com
